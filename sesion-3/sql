-- Listar empleoados según el ID de departamento seleccionado
SELECT dep.dept_no,  e.emp_no, concat(first_name,' ', last_name) as employee, dep.dept_name
FROM employees.employees e
INNER JOIN employees.dept_emp d
	ON d.emp_no = e.emp_no
INNER JOIN employees.departments dep
	ON dep.dept_no = d.dept_no
WHERE dep.dept_no = 'd008' -- se cambia según el select
LIMIT 15
